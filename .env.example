# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# PostgreSQL (banco dedicado comunicados)
POSTGRES_DB=comunicados
POSTGRES_USER=comunicados
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/comunicados
DB_USERNAME=comunicados
DB_PASSWORD=troque-esta-senha
DB_DRIVER=org.postgresql.Driver
FLYWAY_BASELINE_ON_MIGRATE=true

# JWT (validar token emitido pelo Hub)
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Hub (integração)
HUB_API_URL=http://localhost:8080
HUB_MOCK_ENABLED=true

# RabbitMQ (sincronização de tags via Core)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
MESSAGING_ENABLED=true

# Storage S3 (true = mock local sem AWS; false = S3 real, exige buckets e credenciais)
STORAGE_MOCK_ENABLED=true
# Bucket A: recebe todo upload raw via presign (imagem, pdf, video, svg); Lambda
# comprime imagens raster e preserva os demais tipos como estão
STORAGE_IMAGES_BUCKET=comunicados-raw-sa
# Bucket B: destino exclusivo da Lambda (imagens comprimidas + demais tipos preservados)
STORAGE_FILES_BUCKET=comunicados-processed-sa
STORAGE_REGION=sa-east-1
STORAGE_MAX_FILES=5
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_MAX_IMAGE_SIZE_MB=10
STORAGE_MAX_DOCUMENT_SIZE_MB=20
STORAGE_MAX_VIDEO_SIZE_MB=200

# Credenciais AWS (cadeia padrão do SDK; obrigatórias em prod com STORAGE_MOCK_ENABLED=false,
# dispensáveis se rodando com IAM role/instance profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Scheduling (jobs agendados)
AUTO_PUBLISH_ENABLED=true
AUTO_PUBLISH_CRON=0 * * * * *
# Limpeza de AnnouncementFile PENDING abandonados (#174)
CLEANUP_ORPHANS_ENABLED=true
CLEANUP_ORPHANS_CRON=0 0 * * * *
CLEANUP_ORPHANS_MAX_AGE_HOURS=24
