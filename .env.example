# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# PostgreSQL (banco dedicado comunicados)
POSTGRES_DB=comunicados
POSTGRES_USER=comunicados
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/comunicados
DB_USERNAME=comunicados
DB_PASSWORD=troque-esta-senha
DB_DRIVER=org.postgresql.Driver
FLYWAY_BASELINE_ON_MIGRATE=true

# JWT (validar token emitido pelo Hub)
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Hub (integração)
HUB_API_URL=http://localhost:8080
HUB_MOCK_ENABLED=true

# RabbitMQ (sincronização de tags via Core)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
MESSAGING_ENABLED=true
