{
	"info": {
		"_postman_id": "20fa9446-c8e8-4681-a31b-b505c5795ab8",
		"name": "Comunicados - REPRESENTATIVE",
		"description": "Testes de comunicados para perfil **REPRESENTATIVE**.\n\n**Pré-requisitos:**\n1. Core em `{{coreBaseUrl}}` e Comunicados em `{{baseUrl}}`\n2. Rode a coleção **Core - Login** para obter `{{tokenRepresentative}}`\n3. Para TEACHER/REPRESENTATIVE/STUDENT: rode **Core - Login** até a pasta **04 - Re-login**\n\n**Ordem sugerida:** Publicar → Agendar → Listar → Buscar → Fixar → Editar → Desafixar → Deletar",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{tokenRepresentative}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "01 - Publicar",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/posts/publish",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"posts",
						"publish"
					]
				},
				"description": "Publica comunicado como REPRESENTATIVE. Esperado: 201.",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"[REPRESENTATIVE] Retirada de documentos\",\n  \"description\": \"Comparecer na secretaria até sexta-feira (REPRESENTATIVE).\",\n  \"origin\": \"SENAI\",\n  \"destinations\": [\n    { \"type\": \"CLASS\", \"referenceId\": \"{{classId}}\" }\n  ],\n  \"pinned\": false,\n  \"tagIds\": []\n}"
				},
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{tokenRepresentative}}",
							"type": "string"
						}
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const expected = 201;",
							"pm.test(`Status ${expected}`, () => pm.response.to.have.status(expected));",
							"if (pm.response.code === 201) {",
							"    const body = pm.response.json();",
							"    pm.environment.set('postId', body.id);",
							"    pm.test('Status PUBLISHED', () => pm.expect(body.status).to.eql('PUBLISHED'));",
							"    pm.test('Origin SENAI', () => pm.expect(body.origin).to.eql('SENAI'));",
							"}"
						],
						"type": "text/javascript"
					}
				}
			]
		},
