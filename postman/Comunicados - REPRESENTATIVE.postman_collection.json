					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 201', () => pm.response.to.have.status(201));",
							"if (pm.response.code === 201) {",
							"    const body = pm.response.json();",
							"    pm.environment.set('scheduledPostId', body.id);",
