{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "Comunicados Backend",
    "description": "Collection para testes manuais do comunicados-backend.\n\nSetup:\n1. Suba a API: ./mvnw spring-boot:run\n2. Importe o environment comunicados-local.postman_environment.json\n3. Gere JWT no jwt.io (HS256, secret base64 encoded)\n4. Cole o token em {{token}} ou {{tokenSenai}}\n\nGuia completo: docs/postman-testing-guide.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    }
  ],
  "item": [
    {
      "name": "00 - Saúde",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Não requer autenticação. Esperado: 200 com status UP."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Listar sem token (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            },
            "description": "Esperado: 401 Authentication is required."
          },
          "response": []
        },
        {
          "name": "Listar com token (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Usa Bearer {{token}} da collection. Esperado: 200."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Comunicados",
      "item": [
        {
          "name": "Publicar (GENERAL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('postId', body.id);",
                  "    pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "    pm.test('Status PUBLISHED', () => pm.expect(body.status).to.eql('PUBLISHED'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Retirada de documentos\",\n  \"description\": \"Comparecer na secretaria até sexta-feira.\",\n  \"origin\": \"SENAI\",\n  \"destinations\": [\n    { \"type\": \"GENERAL\", \"referenceId\": null }\n  ],\n  \"pinned\": false,\n  \"tagIds\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "publish"]
            },
            "description": "Cria e publica em uma transação (#107). Salva postId no environment."
          },
          "response": []
        },
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Buscar por termo (search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?search=retirada",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "search", "value": "retirada" }
              ]
            },
            "description": "Busca textual #117 em título, descrição, tag e destinatário."
          },
          "response": []
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            },
            "description": "Requer postId preenchido (rode Publicar antes)."
          },
          "response": []
        },
        {
          "name": "Atualizar (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Retirada de documentos (atualizado)\",\n  \"description\": \"Novo horário: 14h às 17h.\",\n  \"origin\": \"SENAI\",\n  \"status\": \"PUBLISHED\",\n  \"pinned\": false,\n  \"pinnedOrder\": 0,\n  \"scheduledFor\": null,\n  \"destinations\": [\n    {\n      \"announcementId\": \"{{postId}}\",\n      \"type\": \"GENERAL\",\n      \"referenceId\": null\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Agendar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('scheduledPostId', body.id);",
                  "    pm.test('Status SCHEDULED', () => pm.expect(body.status).to.eql('SCHEDULED'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Comunicado agendado\",\n  \"description\": \"Publicação futura.\",\n  \"origin\": \"SENAI\",\n  \"scheduledFor\": \"2026-12-31T10:00:00Z\",\n  \"destinations\": [\n    { \"type\": \"GENERAL\", \"referenceId\": null }\n  ],\n  \"pinned\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/schedule",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "schedule"]
            },
            "description": "Cria e agenda (#108). scheduledFor deve ser futuro."
          },
          "response": []
        },
        {
          "name": "Remover (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            },
            "description": "Esperado: 204. Depois GET por ID deve retornar 404."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Escopo e permissões",
      "item": [
        {
          "name": "Publicar como TEACHER (turma OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenTeacher}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Aviso da turma\",\n  \"description\": \"Material para próxima aula.\",\n  \"origin\": \"BOTH\",\n  \"destinations\": [\n    {\n      \"type\": \"CLASS\",\n      \"referenceId\": \"{{classId}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "publish"]
            },
            "description": "Token TEACHER com classId no JWT. Esperado: 201."
          },
          "response": []
        },
        {
          "name": "Publicar como TEACHER (fora da turma)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenTeacher}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Aviso bloqueado\",\n  \"description\": \"Fora do escopo.\",\n  \"origin\": \"SENAI\",\n  \"destinations\": [\n    {\n      \"type\": \"CLASS\",\n      \"referenceId\": \"bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "publish"]
            },
            "description": "Esperado: 403 — turma não está no JWT do professor."
          },
          "response": []
        },
        {
          "name": "Listar como STUDENT",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenStudent}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            },
            "description": "Valida escopo de visibilidade do estudante."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Busca (#117)",
      "item": [
        {
          "name": "Busca por título",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?search=retirada",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "search", "value": "retirada" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Busca + filtro origem",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?origin=SENAI&search=retirada",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "origin", "value": "SENAI" },
                { "key": "search", "value": "retirada" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filtro por turma",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?classId={{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "classId", "value": "{{classId}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Busca vazia (ignora search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?search=%20%20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "search", "value": "   " }
              ]
            },
            "description": "Termo em branco não deve aplicar filtro textual."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Tags",
      "item": [
        {
          "name": "Listar tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tags"]
            },
            "description": "Insira tags no H2 ou via RabbitMQ antes de testar vínculo."
          },
          "response": []
        },
        {
          "name": "Listar tags CLASS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tags?entityType=CLASS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tags"],
              "query": [
                { "key": "entityType", "value": "CLASS" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Vincular tag ao post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tagIds\": [\"{{tagId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "tags"]
            }
          },
          "response": []
        },
        {
          "name": "Listar tags do post",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "tags"]
            }
          },
          "response": []
        },
        {
          "name": "Desvincular tag",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/tags/{{tagId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "tags", "{{tagId}}"]
            },
            "description": "Esperado: 204."
          },
          "response": []
        }
      ]
    }
  ]
}
