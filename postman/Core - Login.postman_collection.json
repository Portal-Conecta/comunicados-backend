								"{{coreBaseUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Cria usuário SENAI. Domínio de e-mail obrigatório conforme tipo.\nE-mail padrão: senai.postman@sc.senai.br\nSe já existir, pode retornar 400/409 — siga para o login.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Postman SENAI\",\n  \"email\": \"{{emailSenai}}\",\n  \"password\": \"{{passwordSenai}}\",\n  \"typeUser\": \"SENAI\"\n}"
						},
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{tokenAdmin}}",
									"type": "string"
								}
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 ou conflito', () => pm.expect([201, 409, 400]).to.include(pm.response.code));",
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    pm.environment.set('userIdSenai', body.id);",
									"    pm.test('typeUser', () => pm.expect(body.typeUser).to.exist);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
